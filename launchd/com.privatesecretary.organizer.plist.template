<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.privatesecretary.organizer</string>
    <key>ProgramArguments</key>
    <array>
        <string>@ORGANIZE_BINARY@</string>
        <string>--home</string>
        <string>@PS_HOME@</string>
        <string>organize</string>
        <string>--since</string>
        <string>2d</string>
        <string>--limit</string>
        <string>300</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>StandardOutPath</key>
    <string>@PS_HOME@/logs/organizer.out.log</string>
    <key>StandardErrorPath</key>
    <string>@PS_HOME@/logs/organizer.err.log</string>
</dict>
</plist>
