<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.privatesecretary.consolidate</string>
    <key>ProgramArguments</key>
    <array>
        <string>@CONSOLIDATE_BINARY@</string>
        <string>--home</string>
        <string>@PS_HOME@</string>
        <string>consolidate</string>
        <string>--yesterday</string>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>10</integer>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>StandardOutPath</key>
    <string>@PS_HOME@/logs/consolidate.out.log</string>
    <key>StandardErrorPath</key>
    <string>@PS_HOME@/logs/consolidate.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PRIVATE_SECRETARY_LOG_LEVEL</key>
        <string>info</string>
    </dict>
</dict>
</plist>
